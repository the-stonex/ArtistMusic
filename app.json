{
  "name": "ArtistMusic",
  "description": "Telegram Music Bot",
  "repository": "https://github.com/the-stonex/ArtistMusic",
  "keywords": [
    "telegram",
    "music",
    "bot",
    "pyrogram"
  ],
  "stack": "container",
  "env": {
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "MONGO_DB_URI": {
      "description": "MongoDB Connection URI",
      "required": true
    },
    "LOGGER_ID": {
      "description": "Logger Group/Channel ID",
      "required": true
    },
    "OWNER_ID": {
      "description": "Owner Telegram User ID",
      "required": true
    },
    "STRING_SESSION": {
      "description": "Telegram Assistant String Session",
      "required": true
    },
    "STRING_SESSION2": {
      "description": "Second Telegram Assistant String Session",
      "required": false
    },
    "STRING_SESSION3": {
      "description": "Third Telegram Assistant String Session",
      "required": false
    },
    "SHRUTI_API_URL": {
      "description": "Shruti API URL",
      "value": "https://api01.shrutibots.site",
      "required": true
    },
    "SHRUTI_API_KEY": {
      "description": "Shruti API Key",
      "required": true
    },
    "ENABLE_API": {
      "description": "Enable Shruti API",
      "value": "True",
      "required": true
    },
    "ENABLE_COOKIES_FALLBACK": {
      "description": "Use YouTube cookies as fallback",
      "value": "True",
      "required": true
    },
    "API_TIMEOUT": {
      "description": "Shruti API connection timeout",
      "value": "300",
      "required": true
    },
    "API_STREAM_TIMEOUT": {
      "description": "Shruti API download stream timeout",
      "value": "600",
      "required": true
    }
  }
}
